# Copy to .env and fill in what you use. Never commit .env.

# Brain (pick in the app under AI Settings; default is Ollama Cloud)
OLLAMA_API_KEY=            # https://ollama.com -> Settings -> Keys
OLLAMA_CLOUD_MODEL=kimi-k3 # optional; e.g. gemma4:31b for faster replies
ANTHROPIC_API_KEY=         # optional: Claude
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=            # optional: OpenAI

# Voice
ELEVENLABS_API_KEY=        # optional: natural voice; without it the browser voice is used
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Network (defaults are safe; only change if you know why)
# YASHI_HOST=127.0.0.1
# YASHI_FRONTEND_URL=http://localhost:5173
